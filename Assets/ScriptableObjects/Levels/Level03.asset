  m_Script: {fileID: 11500000, guid: 4626a54e19105b24e88e08abf90699ec, type: 3}
  m_Name: Level03
  m_EditorClassIdentifier: Assembly-CSharp::Oath.LevelConfig
  levelIndex: 3
  title: "Nh\u1EEFng H\xF2n \u0110\u1EA3o B\u1ECB L\xE3ng Qu\xEAn"
  location: "L\xE0ng ch\xE0i ph\xEDa nam"
  description: "\u0110\u1ECBch t\u1EA5n c\xF4ng t\u1EEB hai h\u01B0\u1EDBng. Ph\xE2n b\u1ED5 t\xE0i nguy\xEAn, s\u1EEDa ch\u1EEFa c\xF4ng tr\xECnh v\xE0 b\u1EA3o v\u1EC7 nh\xE0 d\xE2n l\xE0ng."
  objective: "B\u1EA3o v\u1EC7 l\xE2u \u0111\xE0i v\xE0 d\xE2n l\xE0ng"
  sceneName: 12_Level03
  intro:
  - speaker: "D\xE2n l\xE0ng"
    text: "L\u1EA1y tr\u1EDDi, qu\xE2n Lam \u0111\xE3 t\u1EDBi! Bao n\u0103m nay ch\u1EB3ng ai t\u1EEB kinh \u0111\xF4 ng\xF3 ng\xE0ng t\u1EDBi l\xE0ng ch\xFAng t\xF4i\u2026"
  - speaker: Kael
    text: "Ta xin l\u1ED7i v\xEC \u0111\xE3 t\u1EDBi mu\u1ED9n. L\u1EA7n n\xE0y ch\xFAng ta s\u1EBD kh\xF4ng b\u1ECF ai l\u1EA1i."
  - speaker: Mira
    text: "Trinh s\xE1t b\xE1o \u0111\u1ECBch ti\u1EBFn t\u1EEB hai ph\xEDa: b\u1EDD t\xE2y v\xE0 b\u1EDD \u0111\xF4ng. Con \u0111\u01B0\u1EDDng ph\xEDa t\xE2y \u0111i ngang qua l\xE0ng!"
  - speaker: Mira
    text: "N\u1EBFu t\u1EA5t c\u1EA3 nh\xE0 d\xE2n b\u1ECB ph\xE1 h\u1EE7y, nhi\u1EC7m v\u1EE5 th\u1EA5t b\u1EA1i. H\xE3y d\xF9ng g\u1ED7 \u0111\u1EC3 s\u1EEDa c\xF4ng tr\xECnh khi kh\xF4ng c\xF3 \u0111\u1ECBch \u1EDF g\u1EA7n."
  outro:
  - speaker: "D\xE2n l\xE0ng"
    text: "C\u1EA3m \u01A1n c\xE1c anh. T\u01B0\u1EDBng Veyr\u2026 \xF4ng \u1EA5y sinh ra \u1EDF l\xE0ng b\xEAn c\u1EA1nh. N\u0103m \u0111\xF3i k\xE9m, kinh \u0111\xF4 \u0111\xE3 kh\xF3a kho l\u01B0\u01A1ng."
  - speaker: Kael
    text: "V\u1EADy ra \u0111\xF3 l\xE0 l\xFD do h\u1EAFn ph\u1EA3n l\u1EA1i tri\u1EC1u \u0111\xECnh. Nh\u01B0ng chi\u1EBFn tranh ch\u1EC9 khi\u1EBFn ng\u01B0\u1EDDi d\xE2n kh\u1ED5 th\xEAm."
  - speaker: Mira
    text: "Kael, tin kh\u1EA9n! Veyr d\u1ED3n to\xE0n b\u1ED9 l\u1EF1c l\u01B0\u1EE3ng v\xE2y h\xE3m kinh \u0111\xF4. H\u1EAFn mu\u1ED1n chi\u1EBFm Tr\xE1i Tim B\xECnh Minh."
  tutorialHints:
  - "Ch\xFA \xFD <b>nh\xE0 d\xE2n</b> ph\xEDa t\xE2y b\u1EAFc \u2014 ch\u1EA1m v\xE0o \u0111\u1EC3 s\u1EEDa ch\u1EEFa khi b\u1ECB h\u01B0 h\u1EA1i."
  - "<b>Bom Bi\u1EBFt \u0110i</b> n\u1ED5 tung khi ch\u1EA1m m\u1EE5c ti\xEAu \u2014 h\xE3y h\u1EA1 ch\xFAng t\u1EEB xa!"
  - "M\u1EDBi: <b>Th\xE1p H\u1ECFa Ng\u1EE5c</b> thi\xEAu \u0111\u1ED1t c\u1EA3 \u0111\xE1m k\u1EBB \u0111\u1ECBch theo th\u1EDDi gian."
